# Copy to .env — every variable the system uses, documented.
DATABASE_URL=postgresql+psycopg://yeshshree:yeshshree@localhost:5432/yeshshree
JWT_SECRET=change-me-min-32-chars-random
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=yeshshree
S3_SECRET_KEY=yeshshree123
S3_BUCKET=yeshshree-files
OPS_MODE=parallel_run            # parallel_run | authoritative (also mirrored in app_settings)
# CORS — only the Flutter WEB build needs this (Android uses native HTTP, no CORS).
CORS_ORIGINS=                    # comma-separated explicit prod web origins, e.g. https://ops.yeshshree.com
CORS_ALLOW_LOCALHOST=true        # reflect any http(s)://localhost:<port> for dev/preview web builds
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APK_URL=https://example.com/yeshshree.apk
# SFTP (blank until SAP team provides — outbox worker stays idle without them)
SAP_SFTP_HOST=
SAP_SFTP_USER=
SAP_SFTP_KEY_PATH=
